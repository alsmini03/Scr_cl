{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scrcl",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scrap-cloudflare-db",
      "database_id": "8ccce703-3a48-464e-a4db-2028805c77b5"
    }
  ]
}
